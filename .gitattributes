# Normalize text files and prevent invalid encodings from entering diffs.
# This helps external tooling (e.g., autovalidate) parse PR diffs reliably.

* text=auto eol=lf

# Source code must be UTF-8.
*.java text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.properties text eol=lf

# Explicit binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
